# 複製這個檔案,改名為 local.env,填好後存檔。local.env 不會上傳到 GitHub。

# Cloudflare Worker 網址
WORKER_URL=https://funbox-watch.s1688334.workers.dev

# 與 Worker 的 POLLER_TOKEN 相同(npx wrangler secret put POLLER_TOKEN 時輸入的字串)
POLLER_TOKEN=

# 選填:Discord Webhook,用來傳下單截圖(其他通知由 Worker 發送)
DISCORD_WEBHOOK=

# FunboxSniper 專屬 Chrome 的設定檔(會員登入狀態存在這裡)
CHROME_PROFILE=D:\Website and PWA\funbox-sniper\release_new\chrome_profile

# FunboxSniper「設定 / 更換信用卡」存的加密卡片檔
CARD_FILE=D:\Website and PWA\funbox-sniper\release_new\card.dat

# 0 = 只偵測不下單
BUY_ENABLED=1
